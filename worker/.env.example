# Supabase. The worker writes, so it needs the service role key - NOT the anon
# key. This key bypasses row level security; it belongs in the worker's
# environment and nowhere else.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=

# Detection. Start on yolo11n and only move to yolo11s if the M2 error numbers
# demand it - the bigger model costs roughly 3x the CPU time per frame for a
# gain you should be able to point at in the evaluation table.
HALLCHECK_MODEL=yolo11n.pt
HALLCHECK_CONF_THRESHOLD=0.35

# Capture cadence, seconds. 120 keeps a CPU box comfortable and the number
# fresher than the walk to the dining hall.
HALLCHECK_INTERVAL_SECONDS=120

# Seconds to wait for ffmpeg before giving up on a hall for this tick. A live
# HLS stream that has not produced a frame in 30s is not going to.
HALLCHECK_CAPTURE_TIMEOUT=30

# Per-hall stream URLs, overriding halls.stream_url in the database. Useful for
# pointing a local run at a test stream without touching production config.
# The suffix is the hall_id upper-cased. Worcester has two cameras, so it has
# two ids; Franklin publishes no camera and is seeded inactive.
# HALLCHECK_STREAM_WORCESTER_NORTH=
# HALLCHECK_STREAM_WORCESTER_SOUTH=
# HALLCHECK_STREAM_HAMPSHIRE=
# HALLCHECK_STREAM_BERKSHIRE=
