# The anon key, not the service role key. This ends up in the browser bundle,
# which is fine and intended: it grants select on counts and a column subset of
# halls, and nothing else. See db/migrations/0002_rls_and_read_views.sql and
# db/tests/access_model.sql.
#
# If SUPABASE_SERVICE_KEY ever appears in this directory, something has gone
# badly wrong.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
