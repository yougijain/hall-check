# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# Model weights - never committed, pulled at runtime
*.pt
*.onnx
*.engine

# Frames must never reach disk. These patterns are a backstop, not the control
# - the control is that no code path writes one (see docs/privacy.md).
#
# Note the absence of a bare `*.ts`: HLS segments carry that extension, and so
# does every TypeScript file in web/. Matching media by extension alone would
# silently drop the entire frontend from version control, which is a far worse
# outcome than the stray segment file it would have caught.
*.jpg
*.jpeg
*.png
*.bmp
*.mp4
*.m3u8
*.mkv
*.webm
frames/
captures/
!web/public/**/*.png
!web/public/**/*.svg
!docs/**/*.png

# Node / Next.js
node_modules/
.next/
out/
build/
*.tsbuildinfo
# Regenerated by `next build` on every machine; Next's own scaffolding ignores it.
next-env.d.ts
.vercel/

# Secrets
.env
.env.*
!.env.example

# Local artefacts
*.log
*.db
*.sqlite3
.DS_Store
artifacts/
